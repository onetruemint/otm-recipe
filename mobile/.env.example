# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# See README.md ("Environment setup") for how to get these values.

# Local dev (supabase start): printed as "API URL" in the CLI output.
# Production: Project Settings > API > Project URL in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=

# Local dev (supabase start): printed as "anon key" in the CLI output.
# Production: Project Settings > API > Project API keys > anon/public in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry DSN for crash reporting. Leave empty to disable Sentry (app runs fine without it).
# TODO(owner): create a Sentry project and set this in the real .env once ready.
EXPO_PUBLIC_SENTRY_DSN=

# Google Sign-In: iOS OAuth client ID (Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > iOS). Passed as GoogleSignin.configure()'s
# iosClientId. Leave empty and the app falls back to "not configured".
# TODO(owner): needs Google Cloud OAuth
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google Sign-In: Web OAuth client ID (Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application). Passed as
# GoogleSignin.configure()'s webClientId — required on Android, and used on iOS
# too per the @react-native-google-signin/google-signin library's requirement.
# TODO(owner): needs Google Cloud OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Sign in with Apple on Android goes through Supabase's OAuth browser flow, not
# a client ID env var here. It needs an Apple Services ID and a redirect URL
# configured directly in the Supabase dashboard (Authentication > Providers >
# Apple). See docs/PROGRESS.md for the itemized TODO.
# TODO(owner): needs Apple Developer account
